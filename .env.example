# Copy to .env for local development.
# Never commit real secrets.

ZT_DASHBOARD_HOST=127.0.0.1
ZT_DASHBOARD_PORT=8080
# Required when binding the dashboard to anything other than localhost before the first admin account exists.
ZT_BOOTSTRAP_TOKEN=change-this-local-bootstrap-token
PYTHON_BIN=python

# Optional dashboard session controls.
ZT_COOKIE_SECURE=false
ZT_SESSION_TTL_SECONDS=43200
ZT_MIN_PASSWORD_LENGTH=12
ZT_LOGIN_MAX_FAILURES=5
ZT_LOGIN_LOCKOUT_SECONDS=300

# Optional Postgres session backend. Keep passwords out of saved DSNs; provide
# the password only through the runtime environment when the driver is installed.
# ZT_POSTGRES_PASSWORD=change-this-runtime-only-password

# Optional OIDC authorization-code login. Keep client secrets out of saved
# integration settings; provide the secret only through the runtime environment.
# ZT_OIDC_CLIENT_SECRET=change-this-runtime-only-client-secret

# Optional Vault secret backend. Save only Vault URL/path metadata in dashboard
# settings; provide the Vault token through the runtime environment.
# VAULT_TOKEN=change-this-runtime-only-vault-token

# Optional local defaults for generated scripts and examples.
ZT_NKP_VERSION=v2.17.1
ZT_STANDARD_BUNDLE_PATH=/mnt/c/Share/nkp-bundle_v2.17.1_linux_amd64/nkp-v2.17.1
ZT_AIRGAPPED_BUNDLE_PATH=/mnt/c/Share/nkp-air-gapped-bundle_v2.17.1_linux_amd64/nkp-v2.17.1
